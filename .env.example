# Copy to .env and adjust. Never commit a real .env.

ENVIRONMENT=local
DEBUG=true

# --- Database --------------------------------------------------------------
# Host port is 5433 so this never collides with a local Postgres on 5432.
DATABASE_URL=postgresql+psycopg://gcc:gcc@localhost:5433/gcc

# --- Auth ------------------------------------------------------------------
# dev  -> /api/v1/auth/dev-login issues HS256 tokens (local + test only)
# jwks -> verify RS256 tokens from a managed provider (set JWKS_URL/JWKS_AUDIENCE)
AUTH_PROVIDER=dev
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# JWKS_AUDIENCE=group-chat-court

# --- URLs ------------------------------------------------------------------
WEB_BASE_URL=http://localhost:5173

# --- LLM -------------------------------------------------------------------
# mock       -> no credentials needed; the whole workflow runs locally
# anthropic  -> real verdicts; requires ANTHROPIC_API_KEY
# gemini     -> hosted verdicts in a few seconds; requires GEMINI_API_KEY
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AQ.Ab8RN6JD0nxVTkYljNjcNjMB6kFRjVsvDUgMj9r-0v5JvCD6QQ
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=1
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Ollama only: keep the model loaded between verdicts (default 5m means a ~12s reload).
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
LLM_MAX_ATTEMPTS_PER_CASE=5

# --- Worker ----------------------------------------------------------------
# true: the API drains its own jobs (single-process dev).
# false: a separate `python -m app.services.job_runner` owns generation.
RUN_JOBS_INLINE=true

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
INVITE_TTL_HOURS=72

# Extra browser origins allowed to call the API (comma-separated).
# Browsers treat localhost and 127.0.0.1 as different origins.
# EXTRA_CORS_ORIGINS=http://127.0.0.1:5173

# --- Web (Vite) ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
