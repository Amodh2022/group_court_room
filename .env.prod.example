# Copy to .env on the server. Never commit the real file.

ENVIRONMENT=production
DEBUG=false

API_DOMAIN=api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
WEB_BASE_URL=https://yourdomain.com

# Generate: openssl rand -hex 24  /  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# dev-login must not be exposed in production.
AUTH_PROVIDER=jwks
JWKS_URL=
JWKS_AUDIENCE=group-chat-court

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=1
LLM_TIMEOUT_SECONDS=45

RUN_JOBS_INLINE=false
RATE_LIMIT_ENABLED=true
